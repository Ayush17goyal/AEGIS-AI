LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
DEMO_PASSWORD=AegisDemo!2026
AUDIT_HMAC_KEY=replace-with-a-long-random-value
AUDIT_RETENTION_DAYS=30
DATABASE_URL=sqlite:///./aegis.db

# Synthetic demo authentication only. Production login is intentionally disabled.
AEGIS_ENV=development
AEGIS_DEMO_MODE=true
# Default is approved. 'legacy' is offline-regression-only and never used by Studio.
AEGIS_PIPELINE=approved
# Local NeMo configuration directory containing vetted input rails; no raw-text
# external classifier is configured automatically.
NEMO_CONFIG_PATH=./guardrails
PRESIDIO_SPACY_MODEL=en_core_web_sm
# Optional ZIP-delivered Laya runtime. Keep empty to fail closed with an explicit unavailable status.
LAYA_MODEL_DIR=
LEAK_GW_KEYS=
LEAK_GW_CURRENT_KID=k1
MAX_REQUEST_BYTES=16777216
# Base64 encoding of 32 random bytes. Needed only for recoverable encryption.
AEGIS_VAULT_KEY=
